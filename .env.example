# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
MONGO_URI=mongodb://127.0.0.1:27017/ticket_booking

# Redis Configuration (Upstash or Local Redis URI)
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_ticket_booking_2026
JWT_EXPIRES_IN=7d

# Frontend Client URL (For CORS & Socket.io Allowed Origins)
CLIENT_URL=http://localhost:5173

# Seat Hold & Waitlist Configuration
SEAT_HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900

# Email Delivery Configuration (Nodemailer / SMTP)
EMAIL_USER=tickets@example.com
EMAIL_PASS=smtp_password_placeholder
